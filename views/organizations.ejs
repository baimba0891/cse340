<%- include('partials/header') %>
<h1 class="page-title"><%= title %></h1>
<div class="card-grid">
  <% organizations.forEach((org) => { %>
    <div class="card">
      <img src="<%= org.image %>" alt="<%= org.name %>">
      <h2><%= org.name %></h2>
      <p><%= org.description %></p>
    </div>
  <% }); %>
</div>
<%- include('partials/footer') %>
