<%- include('partials/header') %>
<h1 class="page-title"><%= title %></h1>
<div class="card-grid">
  <% organizations.forEach((org) => { %>
    <div class="card">
      <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %>">
    <h2><a href="/organization/<%= org.organization_id %>">
        <%= org.name %>
      </a></h2>
      <p><%= org.description %></p>
      <p><a href="mailto:<%= org.contact_email %>">
          <%= org.contact_email %>
        </a></p>
    </div>
  <% }); %>
</div>
<%- include('partials/footer') %>
