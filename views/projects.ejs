<%- include('partials/header') %>
<h1 class="page-title"><%= title %></h1>
<div class="card-grid">
  <% serviceProjects.forEach((project) => { %>
    <div class="card">
  <h2>
    <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' }) %>: <a
        href="/project/<%= project.project_id %>">
        <%= project.title %>
      </a> (<a href="/organization/<%= project.organization_id %>">
        <%= project.organization_name %>
      </a>)
  </h2>
    <p>
      <%= project.description %>
    </p>
    <p><strong>Location:</strong>
      <%= project.location %>
    </p>
    </div>
  <% }); %>
</div>
<%- include('partials/footer') %>
