<%- include('partials/header') %>
<h1 class="page-title"><%= title %></h1>
<div class="card-grid">
  <% serviceProjects.forEach((project) => { %>
    <div class="card">
    <h2>
      <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' , month: 'short' , day: 'numeric' })
        %>: <%= project.title %> (<%= project.organization_name %>)
    </h2>
    <p>
      <%= project.description %>
    </p>
    <p><strong>Location:</strong>
      <%= project.location %>
    </p>
    </div>
  <% }); %>
</div>
<%- include('partials/footer') %>
